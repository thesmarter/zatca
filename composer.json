{
    "name": "thesmarter/zatca",
    "description": "ZATCA E-Invoicing integration tools",
    "keywords": [
        "zatca",
        "fatoora",
        "e-invoicing"
    ],
    "homepage": "https://github.com/thesmarter/zatca",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "eltayeb",
            "email": "elteyab@smart.sd",
            "role": "Developer"
        },
        {
            "name": "CoderX249",
            "email": "324578372+CoderX249@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.2",
        "ext-dom": "*",
        "ext-xsl": "*",
        "ext-json": "*",
        "ext-bcmath": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Smart\\Zatca\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Smart\\Zatca\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "cs": "vendor/bin/phpcs",
        "cs-fix": "vendor/bin/phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}
