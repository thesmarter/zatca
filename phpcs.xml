<?xml version="1.0"?>
<ruleset name="ZATCA">
    <description>PSR-12 coding standard for thesmarter/zatca package.</description>

    <rule ref="PSR12">
        <!-- Line length is advisory only: src/tests/examples embed long
             base64, XML and signed-invoice fixtures plus ZATCA endpoint URLs
             that cannot be wrapped without changing string values or harming
             readability, so this sniff is excluded while keeping PSR-12. -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <file>src</file>
    <file>tests</file>
    <file>examples</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
</ruleset>
